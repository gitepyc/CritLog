# Config for https://github.com/BigWigsMods/packager, used by
# .github/workflows/release.yml on every tag push. No CurseForge/Wago
# project id is configured, so releases only reach GitHub.

package-as: CritLog

# Ship the hand-maintained changelog as-is instead of letting the packager
# auto-generate one from raw git log messages.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - docs
  - media/icon.svg
  - tests
  - scripts
  - README.md
  - LICENSE
  - .luacheckrc
  - .editorconfig
  - .gitattributes
